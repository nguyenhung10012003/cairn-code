{
  "name": "cairn-code",
  "version": "0.1.0",
  "description": "A terminal coding agent: agent loop, tools, permissions, hooks, sessions and checkpoints.",
  "keywords": [
    "cli",
    "coding-agent",
    "ai",
    "llm",
    "anthropic",
    "openai",
    "ollama",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "cairn": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "bun --no-env-file --config=/dev/null src/cli.ts",
    "test": "bun test --timeout 60000",
    "test:live": "bun --no-env-file --config=/dev/null test/live/anthropic.live.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/cairn",
    "build:npm": "bun scripts/build-npm.ts",
    "prepack": "bun run build:npm",
    "prepublishOnly": "bun run typecheck && bun test --timeout 60000"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1"
  }
}
